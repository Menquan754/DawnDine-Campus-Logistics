# 阿里云百炼（DashScope）API Key
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=replace-with-your-dashscope-key

# 可选：视觉模型 ID；默认 qwen3-vl-plus
# 如账号区域或可用模型不同，可在此覆盖
DASHSCOPE_VL_MODEL=qwen3-vl-plus

# 可选：网页服务配置（也可用命令行 --host/--port/--share 覆盖）
# 默认只允许本机访问；局域网共享可改为 0.0.0.0
DAWNDINE_HOST=127.0.0.1
DAWNDINE_PORT=7860
# 是否生成 Gradio 临时公网链接（1=开启，需要互联网）
DAWNDINE_SHARE=0

# 公开部署建议设为 0：网页会话不再读取服务器 .env 中的共享 Key，
# 强制每位访客在页面填写自己的 Key；刷新页面即清空。
DAWNDINE_ALLOW_ENV_KEY=1
